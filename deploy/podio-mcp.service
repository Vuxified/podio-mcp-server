[Unit]
Description=Podio MCP Server (Streamable HTTP transport)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/podio-mcp-server
# Replaced at deploy time by deploy.sh with absolute node-22 path
ExecStart=__NODE_BIN__ dist/index.js
Restart=on-failure
RestartSec=10
EnvironmentFile=/home/ec2-user/podio-mcp-server/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=podio-mcp

[Install]
WantedBy=multi-user.target
