PODIO_CLIENT_ID=your_client_id
PODIO_CLIENT_SECRET=your_client_secret
PODIO_REDIRECT_URI=http://localhost:8888/callback
PODIO_TOKEN_PATH=.podio-tokens.json

# Transport: "http" for Streamable HTTP (EC2), omit or leave blank for stdio (local)
MCP_TRANSPORT=
# HTTP port (only used when MCP_TRANSPORT=http)
PORT=3000
